# Data source (icij | synthetic)
DATA_SOURCE=icij

# NVIDIA LLM (free key from build.nvidia.com)
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# FalkorDB connection (local Docker or FalkorDB Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Graph name
GRAPH_NAME=ownership

# FastAPI CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8000

# LLM daily cap (requests per day, resets on process restart)
DAILY_LLM_CAP=300

# Set to 1 to run without LLM (deterministic fallback only)
NO_LLM=0
